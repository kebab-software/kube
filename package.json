{
  "name": "kube-music",
  "version": "0.1.0",
  "private": true,
  "description": "A private, local-first Invidious music player",
  "author": "Kube contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "smoke:live": "node scripts/smoke-live.mjs",
    "desktop": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder --publish never",
    "build:desktop:dir": "npm run build && electron-builder --dir --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "build:android": "npm run android:sync && node scripts/android-build.mjs",
    "build:android:release": "npm run android:sync && node scripts/android-build.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": { "minimatch": "^10.2.0" },
  "build": {
    "appId": "app.kube.music",
    "productName": "Kube",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" }
  }
}
