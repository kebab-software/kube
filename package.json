{
  "name": "kube-music",
  "version": "0.2.0",
  "private": true,
  "description": "A private, local-first Invidious music player",
  "author": "Kube contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run icons",
    "prebuild": "npm run icons",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "smoke:live": "node scripts/smoke-live.mjs",
    "desktop": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder --publish never",
    "build:desktop:dir": "npm run build && electron-builder --dir --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "build:android": "npm run android:sync && node scripts/android-build.mjs",
    "build:android:release": "npm run android:sync && node scripts/android-build.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "build": {
    "appId": "app.kube.music",
    "productName": "Kube",
    "directories": {
      "output": "release",
      "buildResources": "build/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "kebab-software",
        "repo": "kube",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons/icon.png",
      "category": "AudioVideo"
    }
  }
}
